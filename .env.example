# Copy to .env.local for overrides. Both are gitignored.
#
# Leave VITE_API_URL UNSET when the SPA is served from the same origin as the
# API — which is the case in development (Vite proxies /api-inventory and
# /socket.io to port 3009) and in any deployment that serves both together.
# The app then uses relative URLs and simply works.
#
# Set it only when the API lives somewhere else. Give the full base path; the
# socket layer reduces it to an origin on its own.
#
# VITE_API_URL=https://api.example.com/api-inventory
